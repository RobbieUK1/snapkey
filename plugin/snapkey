#!/usr/bin/env python3
"""Snapkey's backend: read and write Omarchy's screenshot key bindings.

Every command prints one JSON object on stdout. The actual bindings live in a
managed block at the end of ~/.config/hypr/bindings.lua, so the app never owns
the whole file and a reset puts Omarchy's defaults back by deleting the block.

Set SNAPKEY_BINDINGS or SNAPKEY_HYPRCTL to point the tests at a temporary file
and a fake hyprctl.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

BEGIN = "-- Snapkey: screenshot keys (start)"
END = "-- Snapkey: screenshot keys (end)"
PREFIX = "Snapkey: "

ACTIONS = [
    {
        "id": "smart",
        "label": "Smart screenshot",
        "command": "omarchy capture screenshot smart",
        "section": "screenshots",
        "defaults": [
            {"chord": "PRINT", "description": "Screenshot"},
            {"chord": "SUPER + CTRL + ALT + C", "description": "Screenshot"},
        ],
