        "label": "Region",
        "command": "omarchy capture screenshot region",
        "section": "screenshots",
        "defaults": [],
    },
    {
        "id": "window",
        "label": "Window",
        "command": "omarchy capture screenshot windows",
        "section": "screenshots",
        "defaults": [],
    },
    {
        "id": "fullscreen",
        "label": "Full screen",
        "command": "omarchy capture screenshot fullscreen",
        "section": "screenshots",
        "defaults": [],
    },
    {
        "id": "fullscreen-save",
        "label": "Full screen (save)",
        "command": "omarchy capture screenshot fullscreen save",
        "section": "screenshots",
        "defaults": [],
    },
    {
        "id": "scroll",
        "label": "Scrolling region",
        "command": "omarchy capture screenshot scroll",
        "section": "screenshots",
        "defaults": [],
    },
    {
        "id": "text",
        "label": "Text (OCR)",
        "command": "omarchy capture text",
        "section": "more",
        "defaults": [
            {
                "chord": "SUPER + CTRL + PRINT",
                "description": "Extract text (OCR) from screenshot",
            }
        ],
    },
    {
